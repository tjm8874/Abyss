{
  "exe": "<workdir>/build/strata",
  "args": [
    "--glm-pack",
    "<workdir>/model/pack",
    "--max-context",
    "32768",
    "--prefill",
    "4096",
    "--layer-split",
    "20"
  ],
  "gpu": [
    0,
    1
  ],
  "cwd": "<workdir>/official/cap-split20-own6",
  "tokenizer": "<workdir>/model/pack/tokenizer",
  "backend": "cuda",
  "port": 18959,
  "env": {
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "CUDA_VISIBLE_DEVICES": "0,1",
    "STRATA_GLM_NO_REUSE": "1",
    "STRATA_GLM_USAGE": "0",
    "STRATA_GLM_RAM_GB": "119.20928955078125",
    "STRATA_GLM_CPU_LANE": "6",
    "STRATA_Q4X_MTP": "<workdir>/mtp",
    "STRATA_GLM_SPLIT_LOG": "1",
    "STRATA_GLM_PRIOR": "<workdir>/source/data/expert_counts/qwen38-flash-next.txt",
    "STRATA_GLM_VRAM_GB_PARTS": "16,32",
    "STRATA_GLM_CPU_SHARED": "0"
  }
}
