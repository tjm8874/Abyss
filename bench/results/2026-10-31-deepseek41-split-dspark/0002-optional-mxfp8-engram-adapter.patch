@@ -0,0 +1,19 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+namespace strata::core {
+// MXFP8: eight [E8M0 scale, 32 E4M3 codes] blocks per 256-element row.
+// The shared LUT preserves the existing Engram BF16 reconstruction contract.
+inline bool decode_engram_mxfp8(const uint8_t* raw, float* dst, const uint32_t (&lut)[256][256]) {
+    for (int block = 0; block < 8; ++block) {
+        const uint8_t* p = raw + 33 * block;
+        for (int j = 0; j < 32; ++j) {
+            const uint32_t bits = lut[p[0]][p[1 + j]];
+            if (bits == 0xffffffffu) return false;
+            std::memcpy(dst + 32 * block + j, &bits, sizeof(bits));
+        }
+    }
+    return true;
+}
+}  // namespace strata::core
